# 비밀값 템플릿 — 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
#   cp .env.example .env
# .env 는 .gitignore 로 git 에 올라가지 않습니다.

# 텔레그램 봇 (BotFather 에서 발급)
TELEGRAM_BOT_TOKEN=여기에_봇_토큰
TELEGRAM_CHAT_ID=여기에_chat_id

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 관리자 페이지(/admin) 비밀번호 해시 — 직접 쓰지 말고 아래 명령으로 설정
#   PYTHONPATH=src .venv/bin/python -m smartfarm.web.admin_password
#   (숫자 4자리 PIN 또는 10자 이상 비밀번호)
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD_KIND=pin
